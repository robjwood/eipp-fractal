<ul class="c-card-wrap {{ cardModifier }}">
  {{# pageBlocks }}
  
    <li class="c-card">
      <a href="{{ url }}" class="c-card__link black no-underline {{ linkClass }}">
        <div class="c-card__img">
          <img src="{{ img }}" />
        </div>
        <div class="u-pa2">
          <h2 class="u-mt0 tracked-tight f3 u-mb1">A small card</h2>
          <p class="u-mb0 f5">Small copy</p>
        </div>
        {{!-- <a href="{{ url }}" class="u-mb0 f5 {{ linkClass }}">{{ linkLabel }}</a> --}}
      </a>
    </li>

  {{/ pageBlocks }}
</ul>